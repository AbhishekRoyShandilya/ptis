# ══════════════════════════════════════════
# PTIS Configuration
# Copy to .env and fill in your values
# ══════════════════════════════════════════

# ── Database ──
# Local dev:
DATABASE_URL=postgresql://ptis:ptis@localhost:5432/ptis
# Docker: (set automatically by docker-compose, no need to change)
# DATABASE_URL=postgresql://ptis:ptis@db:5432/ptis

# ── Application ──
DEBUG=true
LOG_LEVEL=INFO

# ── Security ──
# REQUIRED in production (DEBUG=false). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
PTIS_JWT_SECRET=change-me

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── LLM ──
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-3-sonnet-20240229
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60

# ── Broker API (uncomment your broker) ──

# Zerodha / Kite Connect (https://developers.kite.trade)
# KITE_API_KEY=your_kite_api_key
# KITE_API_SECRET=your_kite_api_secret
# KITE_ACCESS_TOKEN=

# Angel One / SmartAPI (https://smartapi.angelone.in)
# ANGEL_API_KEY=your_angel_api_key
# ANGEL_CLIENT_ID=your_client_id
# ANGEL_PASSWORD=your_pin
# ANGEL_TOTP_SECRET=your_totp_base32_secret

# Upstox
# UPSTOX_API_KEY=
# UPSTOX_ACCESS_TOKEN=

# Groww
# GROWW_API_KEY=your_groww_api_key
# GROWW_API_SECRET=your_groww_api_secret
# GROWW_ACCESS_TOKEN=

# ── Market Settings ──
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30

# ── Price Feed (optional) ──
# POLYGON_API_KEY=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=

# ── Observability (optional) ──
# SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456

# ── Risk Defaults ──
DEFAULT_RISK_PERCENT=1.0
MAX_RISK_PERCENT=2.0
MAX_DAILY_LOSS_PERCENT=3.0
MAX_DAILY_TRADES=8

# ── Behavioral Thresholds ──
REVENGE_TRADE_WINDOW_MINUTES=15
FOMO_RAPID_ENTRY_MINUTES=5
OVERSIZE_THRESHOLD_MULTIPLIER=1.5

# ── Coaching ──
COACHING_DEFAULT_PERSONALITY=balanced
COACHING_MAX_CONTEXT_TRADES=20
COACHING_MAX_CONVERSATION_HISTORY=20
COACHING_SESSION_TIMEOUT_HOURS=4
